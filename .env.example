# Required. The server refuses to start if either key is missing.
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Server
PORT=3000
DATABASE_URL=sqlite:school_chat.db

# Logging: "pretty" for local development, "json" for production aggregators.
LOG_FORMAT=pretty
RUST_LOG=info,sqlx=warn,tower_http=info,axum=info

# SQLite pool and queue tuning (defaults shown).
SQLITE_MAX_CONNECTIONS=5
QUEUE_CAPACITY=8
WORKER_INTERVAL_SECS=4
AI_ATTEMPT_TIMEOUT_SECS=30
CHAT_RESPONSE_TIMEOUT_SECS=180
SHUTDOWN_TIMEOUT_SECS=25

# Optional: path to the school knowledge file.
# SCHOOL_KNOWLEDGE_PATH=school_knowledge.md
# Optional: override the H1 in school_knowledge.md.
# SCHOOL_NAME=Northgate International School

# Optional: replace the built-in model order with a comma-separated list.
# Provider catalogues change; check your account before deploying.
# The built-in defaults are:
# GROQ_MODELS=llama-3.3-70b-versatile,meta-llama/llama-4-scout-17b-16e-instruct,llama-3.1-8b-instant
# OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,google/gemma-2-9b-it:free

# Optional provider endpoint / OpenRouter header overrides.
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
# OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
# OPENROUTER_HTTP_REFERER=http://localhost:3000
# OPENROUTER_APP_TITLE=School Chat
