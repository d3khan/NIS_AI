# Required. The server refuses to start if either key is missing.
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Server
PORT=3000

# Required: PostgreSQL connection string.
# The schema is created automatically on first start.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/school_chat
# Recommended on Neon: the direct (non-pooled) URL used only for schema
# bootstrap. Application queries use DATABASE_URL (the pooled URL).
# `neon deploy` writes both automatically.
# DATABASE_URL_UNPOOLED=postgres://user:password@host/db?sslmode=require

# Required: bearer token for the admin-only /neon/* endpoints.
# Generate with: openssl rand -hex 32
NEON_ADMIN_TOKEN=

# Neon branch services. `neon deploy` (or `neon env pull`) writes these;
# leave them empty when running without Neon.
# NEON_FUNCTION_HELLO_BASE_URL=https://<branch>-hello.compute.<region>.aws.neon.tech/
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=https://<branch>.storage.<region>.aws.neon.tech
# AWS_REGION=eu-central-1
# NEON_REALTIME_URL=wss://<branch>.rt.<region>.aws.neon.tech
# NEON_REALTIME_SECRET=nrt_live_1...
# Optional: bucket name from neon.ts (defaults to "assets").
# NEON_STORAGE_BUCKET=assets

# Logging: "pretty" for local development, "json" for production aggregators.
LOG_FORMAT=pretty
RUST_LOG=info,sqlx=warn,tower_http=info,axum=info

# Database pool, queue, and shutdown tuning (defaults shown).
DATABASE_MAX_CONNECTIONS=5
QUEUE_CAPACITY=8
WORKER_INTERVAL_SECS=4
AI_ATTEMPT_TIMEOUT_SECS=30
CHAT_RESPONSE_TIMEOUT_SECS=180
SHUTDOWN_TIMEOUT_SECS=25

# Optional: path to the school knowledge file.
# SCHOOL_KNOWLEDGE_PATH=school_knowledge.md
# Optional: override the H1 in school_knowledge.md.
# SCHOOL_NAME=Nobles International School

# Optional: replace the built-in model order with a comma-separated list.
# Provider catalogues change; check your account before deploying.
# The built-in defaults are:
# GROQ_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b
# OPENROUTER_MODELS=openrouter/free

# Optional provider endpoint / OpenRouter header overrides.
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
# OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
# OPENROUTER_HTTP_REFERER=http://localhost:3000
# OPENROUTER_APP_TITLE=School Chat
